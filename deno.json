{
  "tasks": {
    "dev": "deno run --allow-run --allow-read --allow-write --allow-env src/main.ts",
    "test": "deno test --allow-run --allow-read --allow-write --allow-env",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "compile": "deno compile --allow-run --allow-read --allow-write --allow-env --output notikun src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/cli": "jsr:@std/cli@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.2"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
